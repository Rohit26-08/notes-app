generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model DayNote {
  id        String   @id @default(cuid())
  date      String   @unique
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Draft {
  id        String   @id @default(cuid())
  title     String   @default("")
  type      String   @default("article")
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
