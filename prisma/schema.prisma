generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model DayNote {
  id        String   @id @default(cuid())
  date      String
  content   String   @default("")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, userId])
}

model Draft {
  id        String   @id @default(cuid())
  title     String   @default("")
  type      String   @default("article")
  content   String   @default("")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HourLog {
  id        String   @id @default(cuid())
  date      String
  hour      Int
  content   String   @default("")
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([date, hour, userId])
}

model Goal {
  id          String      @id @default(cuid())
  weekStart   String
  text        String
  description String      @default("")
  userId      String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  checks      GoalCheck[]

  @@index([weekStart, userId])
}

model GoalCheck {
  id     String  @id @default(cuid())
  goalId String
  day    Int
  done   Boolean @default(false)
  userId String
  goal   Goal    @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@unique([goalId, day])
}
